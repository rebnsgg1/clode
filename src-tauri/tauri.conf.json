{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Моє меню",
  "mainBinaryName": "moie-menu",
  "version": "../package.json",
  "identifier": "ua.moiemenu.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Моє меню",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Моє меню",
    "copyright": "© 2026 Моє меню",
    "category": "Lifestyle",
    "shortDescription": "Особиста книга рецептів",
    "longDescription": "Моє меню — особиста книга рецептів: ПП і звичайні страви, страва дня, меню на день, тижневий планувальник, список покупок і режим готування. Працює повністю без інтернету.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Ukrainian"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
